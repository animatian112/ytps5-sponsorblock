#
# Copy this file to .env. The local .env file is ignored by Git and read by
# Make; keep application identity and release metadata in sce_sys/param.json.

PS5_HOST=192.168.1.100
FTP_PORT=2121
DEPLOY_DRY_RUN=0

# The console app links libcurl (youtube-tv/src/platform/ps5/console_curl.c),
# OpenSSL and ffmpeg from the pinned PacBrew sysroot.
PACBREW_PACKAGES=libcurl openssl libavformat libavcodec libavutil libswscale libswresample

# Defaults to all available logical CPUs; lower this on memory-limited hosts.
# BUILD_JOBS=8
# USE_CCACHE=0
